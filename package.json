{
  "name": "shoah-never-again",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "data:subcamps": "node scripts/build-subcamps.mjs",
    "data:beg": "node scripts/parse-beg.mjs",
    "data:dewiki": "node scripts/parse-dewiki.mjs",
    "data:routes": "node scripts/build-routes.mjs",
    "data:fronts": "node scripts/build-fronts.mjs",
    "data:images": "node scripts/fetch-images.mjs",
    "data:names": "node scripts/fetch-names.mjs && node scripts/pack-names.mjs",
    "data:films": "node scripts/fetch-films.mjs",
    "data:event-images": "node scripts/fetch-event-images.mjs",
    "data:memorials": "node scripts/fetch-memorial-images.mjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "polygon-clipping": "^0.15.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
